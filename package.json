{
  "name": "merch-store",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve monolith",
    "build": "ng build monolith",
    "watch": "ng build monolith --watch --configuration development",
    "test": "ng test monolith --watch=false",
    "lint": "ng lint monolith",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "build:stats": "ng build monolith --stats-json",
    "check:bundles": "npm run build:stats && node tools/check-bundles.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/aria": "~22.2.0",
    "@angular/cdk": "~22.2.5",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
